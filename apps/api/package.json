{
  "name": "@tattoo-quotes/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node --disable-warning=ExperimentalWarning --import tsx src/seed.ts"
  },
  "dependencies": {
    "express": "5.2.1",
    "multer": "2.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.4",
    "tsx": "4.23.15"
  }
}
